# Public client configuration. This file is a template; .env is gitignored.
# Both values are safe to expose in a desktop app *only* while RLS is enabled
# and self-signup is disabled in Supabase Auth.
RECURRING_SUPABASE_URL=https://<project-ref>.supabase.co
RECURRING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Never add these here:
# SUPABASE_SECRET_KEY / service_role key
# database password
# Supabase access token
